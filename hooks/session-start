#!/usr/bin/env bash
# SessionStart hook for the instincts plugin.
# Injects the using-instincts entry skill plus a short primer so the agent
# keeps the four reflex skills active and reaches for them at the right moment.

set -euo pipefail

# Determine plugin root directory
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

# Read using-instincts content
using_instincts_content=$(cat "${PLUGIN_ROOT}/skills/using-instincts/SKILL.md" 2>&1 || echo "Error reading using-instincts skill")

# Escape string for JSON embedding using bash parameter substitution.
# Each ${s//old/new} is a single C-level pass.
escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

using_instincts_escaped=$(escape_for_json "$using_instincts_content")

primer="The instincts layer is installed. It tunes a set of working reflexes on top of your normal process: verify claims against the source instead of memory, build for failures you can't reproduce, look wider than the line in front of you, and finish honestly. When one of these applies to what you're about to do, you MUST load the matching skill with the Skill tool BEFORE you act and announce it — applying the principle from memory without loading the skill does not count and cuts corners. These skills are not exempt from the invoke-the-skill discipline. The full map and the rule are in the 'instincts:using-instincts' skill below; each skill is loadable on its own with the Skill tool."

session_context="<IMPORTANT>\n${primer}\n\n${using_instincts_escaped}\n</IMPORTANT>"

# Output context injection as JSON.
# Cursor hooks expect additional_context (snake_case).
# Claude Code hooks expect hookSpecificOutput.additionalContext (nested).
# Copilot CLI and others expect additionalContext (top-level, SDK standard).
# Uses printf instead of heredoc to work around bash 5.3+ heredoc hang.
if [ -n "${CURSOR_PLUGIN_ROOT:-}" ]; then
  printf '{\n  "additional_context": "%s"\n}\n' "$session_context"
elif [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -z "${COPILOT_CLI:-}" ]; then
  printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$session_context"
else
  printf '{\n  "additionalContext": "%s"\n}\n' "$session_context"
fi

exit 0
